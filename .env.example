# Backend Environment Variables
# Copy this to .env for local development

# === Required Settings ===
ENVIRONMENT=production
DATABASE_URL=postgresql://user:pass@localhost:5432/socialraven
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# === CORS & URLs ===
BACKEND_URL=https://api.socialraven.online
FRONTEND_URL=https://socialraven.online
CORS_ORIGINS=https://socialraven.online,https://www.socialraven.online,https://highshift.cloud,https://www.highshift.cloud

# === Optional: Scheduler & Temporal ===
RUN_SCHEDULER=true
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal:7233
RUN_TEMPORAL_WORKER=true

# === Redis (for caching/sessions) ===
REDIS_URL=redis://localhost:6379

# === Social Media API Settings ===
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://api.socialraven.online/auth/connect/twitter/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api.socialraven.online/auth/connect/facebook/callback

INSTAGRAM_REDIRECT_URI=https://api.socialraven.online/auth/connect/instagram/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.socialraven.online/auth/connect/linkedin/callback

YOUTUBE_GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly,openid,profile,email

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.socialraven.online/auth/connect/tiktok/callback

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=https://api.socialraven.online/auth/connect/pinterest/callback

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://api.socialraven.online/auth/connect/threads/callback

BLUESKY_ENABLED=true

MASTODON_REDIRECT_URI=https://api.socialraven.online/auth/connect/mastodon/callback

# === Sentry Error Tracking ===
SENTRY_DSN=

# === Cloudflare R2 Storage ===
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# === AI ===
OPENAI_API_KEY=
GEMINI_API_KEY=

# === Payment / Stripe ===
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=